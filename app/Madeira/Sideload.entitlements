<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Independent unsigned build: retain the requested memory, virtual-address,
	     and JIT entitlements in its ad-hoc signature for inspection. This IPA has
	     no provisioning profile or team identity; device acceptance is not
	     asserted by this build. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
